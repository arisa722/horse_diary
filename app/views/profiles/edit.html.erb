<h1>プロフィール編集</h1>

<%= form_with model: @user, url: profile_path do |f| %>
  <% if @user.errors.any? %>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :nickname, "ニックネーム" %>
    <%= f.text_field :nickname %>
  </div>

  <div>
    <%= f.label :introduction, "自己紹介" %>
    <%= f.text_area :introduction %>
  </div>

  <%= f.submit "保存" %>
<% end %>

<%= link_to "戻る", profile_path %>
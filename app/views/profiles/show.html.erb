<h1>マイページ</h1>

<% if @user.icon.attached? %>
  <%= image_tag @user.icon, class: "avatar" %>
<% end %>
<div class="card">
  <p>ニックネーム：<%= @user.nickname %></p>

  <p>自己紹介</p>
  <%= simple_format(@user.introduction) %>

  <p>レッスン記録：<%= @user.lessons.count %> 件</p>
</div>

<%= link_to "プロフィールを編集", edit_profile_path, class: "btn" %>
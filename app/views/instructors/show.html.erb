<h1><%= @instructor.name %></h1>

<h2>指導の特徴</h2>
<%= simple_format(@instructor.feature) %>

<h2>メモ</h2>
<%= simple_format(@instructor.memo) %>

<%= link_to "編集", edit_instructor_path(@instructor), class: "btn" %>

<p><%= @instructor.lessons.count %>回 レッスンを担当してもらいました</p>

<h2><%= @instructor.name %>さんとのレッスン</h2>
<% if @instructor.lessons.empty? %>
    <p>まだレッスンはありません</p>
<% else %>
    <% @instructor.lessons.order(date: :desc).each do |lesson| %>
         <%= link_to lesson_path(lesson), class: "card" do %>
        <div><strong><%= lesson.date.strftime("%Y年%m月%d日") %></strong></div>
        <div>
          <% lesson.categories.each do |category| %>
            <span class="tag"><%= category.name %></span>
          <% end %>
        </div>
      <% end %>
    <% end %>
<% end %>

<%= link_to "戻る", instructors_path %>


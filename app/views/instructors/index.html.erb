<h1>講師の一覧</h1>

<p><%= link_to "馬", horses_path %> | 講師</p>

<%= link_to "講師の登録", new_instructor_path %>

<% if @instructors.empty? %>
    <p>登録されている講師はいません。</p>
<% else %>
    <% @instructors.each do |instructor| %>
        <p><%= link_to instructor.name, instructor_path(instructor) %></p>
    <% end %>
<% end %>

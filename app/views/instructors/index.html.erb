<h1>馬・講師</h1>

<div class="switch">
  <%= link_to "馬", horses_path %>
  <span class="active">講師</span>
</div>

<%= link_to "講師を登録", new_instructor_path, class: "btn" %>

<% if @instructors.empty? %>
  <p>登録されている講師はいません。</p>
<% else %>
  <% @instructors.each do |instructor| %>
    <%= link_to instructor_path(instructor), class: "card" do %>
      <div><strong><%= instructor.name %></strong></div>
      <div><%= instructor.lessons.count %>回 レッスン</div>
    <% end %>
  <% end %>
<% end %>
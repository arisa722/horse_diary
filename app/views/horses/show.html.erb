<h1><%= @horse.name %></h1>

<% if @horse.image.attached? %>
<%= image_tag @horse.image, class: "photo" %>
<% end %>

<p>毛色：<%= @horse.color&.name %></p>

<h2>性格</h2>
<%= simple_format(@horse.personality) %>

<h2>メモ</h2>
<%= simple_format(@horse.memo) %>

<%= link_to "編集", edit_horse_path(@horse), class: "btn" %>

<p><%= @horse.lessons.count %>回 一緒にレッスンしたよ</p>

<h2><%= @horse.name %>とのレッスン</h2>
<% if @horse.lessons.empty? %>
    <p>まだレッスンはありません</p>
<% else %>
    <% @horse.lessons.order(date: :desc).each do |lesson| %>
                  <%= link_to lesson_path(lesson), class: "card" do %>
        <div><strong><%= lesson.date.strftime("%Y年%m月%d日") %></strong></div>
        <div>
          <% lesson.categories.each do |category| %>
            <span class="tag"><%= category.name %></span>
          <% end %>
        </div>
      <% end %>
    <% end %>
<% end %>

<%= link_to "一覧に戻る", horses_path %>
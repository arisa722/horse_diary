<h1>馬の一覧</h1>

<p>馬 | <%= link_to "講師", instructors_path %></p>

<%= link_to "馬を登録", new_horse_path %>

<% if @horses.empty? %>
  <p>馬が登録されていません。</p>
<% else %>
  <% @horses.each do |horse| %>
    <p>
      <%= link_to horse.name, horse_path(horse) %>
      <%= horse.color&.name %>
    </p>
  <% end %>
<% end %>
<h1><%= @lesson.date.strftime("%Y年%m月%d日") %></h1>

<p>馬: <%= @lesson.horse&.name %></p>
<p>講師: <%= @lesson.instructor&.name %></p>
<p> <% @lesson.categories.each do |category| %>
        <span><%= category.name %></span>
    <% end %>
</p>

<h2>先生からの指導</h2>
<%= simple_format(@lesson.instruction) %>

<h2>感想</h2>
<%= simple_format(@lesson.impression) %>
<h2>次回の目標</h2>
<%= simple_format(@lesson.next_goal) %>

<%= link_to "編集", edit_lesson_path(@lesson) %>
<%= link_to "一覧に戻る", lessons_path %>
